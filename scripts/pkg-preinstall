#!/bin/sh
set -eu

# Remove the previous generation's per-direction bundles and stale per-user
# copies, plus anything left by the upstream 万能鸭 build, so no duplicate
# HAL plug-in can shadow the new one.

for name in HuishengStudio HuishengStudioIn12 HuishengStudioIn34 HuishengStudioIn56 HuishengStudioIn78 \
            HuishengStudioOut12 HuishengStudioOut34 HuishengStudioOut56 HuishengStudioOut78 \
            Wannengya WannengyaIn12 WannengyaIn34 WannengyaIn56 WannengyaIn78 \
            WannengyaOut12 WannengyaOut34 WannengyaOut56 WannengyaOut78; do
    rm -rf "/Library/Audio/Plug-Ins/HAL/$name.driver"
done

# Both generations of the plug-in names: 1.0.7 installed them as
# "HuishengStudio Capture/Return", 1.0.8 and 1.0.9 as "HsAudio Capture/Return".
# Removing both makes an upgrade - and a repeated install of either one -
# idempotent. The driver bundle path did not change in 1.0.9 (only the device
# names it publishes did), so the HAL loop above already covers it.
#
# The system locations are not the only ones: an older build (or a manual copy)
# may have left per-user bundles in ~/Library/Audio/Plug-Ins, and a per-user
# bundle with the same AudioComponents entry shadows the system one in some
# hosts. So drop both locations, VST3 and Audio Unit alike.
for target in /Library/Audio/Plug-Ins /Users/*/Library/Audio/Plug-Ins; do
    case "$target" in
        /Users/*) [ -d "$target" ] || continue ;;
    esac
    for name in "HsAudio Capture" "HsAudio Return" \
                "HuishengStudio Capture" "HuishengStudio Return" \
                "wannengya Capture" "wannengya Return"; do
        rm -rf "$target/VST3/$name.vst3"
        rm -rf "$target/Components/$name.component"
    done
done
rm -rf "/Applications/HuishengStudio Agent.app"
rm -rf "/Applications/wannengya Agent.app"

for home in /Users/*; do
    [ -d "$home" ] || continue
    rm -rf "$home/Applications/HuishengStudio Agent.app"
    rm -rf "$home/Applications/wannengya Agent.app"
done

# Known names are not enough: an experiment build installed under another
# name still claims the same CFPlugIn factory UUID, and two bundles with one
# UUID make every audio client on the machine fail its plug-in lookup while
# coreaudiod rebuilds the list. Removing by UUID catches those - both this
# fork's UUID and the upstream one it was forked from.
FACTORY_UUIDS="6E7696C7-460F-493A-941D-3733613ED3A6 E60A2918-B0D2-4B3D-9CD4-1697DE168E9E"

remove_duplicates()
{
    for bundle in "$1"/*.driver; do
        [ -d "$bundle" ] || continue
        for uuid in $FACTORY_UUIDS; do
            if /usr/bin/plutil -p "$bundle/Contents/Info.plist" 2>/dev/null | /usr/bin/grep -q "$uuid"; then
                rm -rf "$bundle"
                break
            fi
        done
    done
}

remove_duplicates /Library/Audio/Plug-Ins/HAL

for home in /Users/*; do
    [ -d "$home" ] || continue
    remove_duplicates "$home/Library/Audio/Plug-Ins/HAL"
done

/usr/bin/pkill -f 'HuishengStudio Agent.app/Contents/MacOS/HuishengStudio Agent' 2>/dev/null || true
/usr/bin/pkill -f 'wannengya Agent.app/Contents/MacOS/wannengya Agent' 2>/dev/null || true

exit 0
